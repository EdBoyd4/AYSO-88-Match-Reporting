# gss88 auth + RAPP configuration.
# Copy to .env on each server and fill in real values. NEVER commit .env.

# --- Auth / RAPP database ---------------------------------------------------
# Boyd's Little Login Library tables + the rapp_* tables live in this database.
# On the dev box this is the same DB the match-report app uses.
GSS88_AUTH_DB_HOST=localhost
GSS88_AUTH_DB_NAME=xnbglkce_gss88cardreports
GSS88_AUTH_DB_USER=xnbglkce_refs
GSS88_AUTH_DB_PASS=change-me

# --- Session -------------------------------------------------------------------
# Idle timeout in seconds. Overridable at runtime by an RRA via the
# session-settings page; this is the fallback default.
GSS88_SESSION_TIMEOUT_SECONDS=14400

# --- OTP delivery (SMTP) -----------------------------------------------------
# When GSS88_OTP_DEV_LOG_ONLY is true, codes are written to the PHP error log
# instead of being emailed (use on the dev box).
GSS88_OTP_DEV_LOG_ONLY=true
GSS88_SMTP_HOST=gss88.org
GSS88_SMTP_PORT=465
GSS88_SMTP_SECURE=smtps
GSS88_SMTP_USER=sanctionReports@gss88.org
GSS88_SMTP_PASS=change-me
GSS88_SMTP_FROM_EMAIL=sanctionReports@gss88.org
GSS88_SMTP_FROM_NAME=AYSO Region 88 - RAPP

# --- RAPP --------------------------------------------------------------------
GSS88_RAPP_MEDIA_DIR=/home/xnbglkce/gss88/RAPPReports
GSS88_RAPP_RETENTION_HOURS=72
GSS88_RAPP_MAX_AUDIO_BYTES=26214400
GSS88_RAPP_BASE_URL=https://gss88.local/rapp
